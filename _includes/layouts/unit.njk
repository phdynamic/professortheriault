---
layout: layouts/base.njk
---

<h1>{{ title }}</h1>

<div class="reading-content">
  {{ content | safe }}
</div>

{% set pages = collections.all | modulePages(course.slug, module) %}

{% if pages and pages.length > 1 %}
  <h2>In This Unit</h2>
  <ul class="unit-overview__toc">
    {% for pg in pages %}
      {% if pg.url != page.url %}
      <li>
        <a href="{{ pg.url }}">{{ pg.data.title }}</a>
      </li>
      {% endif %}
    {% endfor %}
  </ul>

  <a href="{{ pages[1].url }}" class="unit-overview__begin">Begin Unit &rarr;</a>
{% endif %}
